# Plicit configuration
# Copy to .env and fill in.

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Database ---
# Local: sqlite path. Remote: postgres URL.
DATABASE_URL=sqlite:./data/plicit.db

# --- Notes repo (markdown personal OS, e.g. me-myself-and-i) ---
NOTES_REPO_PATH=

# --- Personal-assistant WhatsApp bot ---
# JID like "972500000000@s.whatsapp.net"
PA_BOT_JID=

# --- Google Calendar (Phase 2 — enables real calendar sync; markdown-only fallback when blank) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Behaviour ---
STALE_MINUTES=60
TZ=Asia/Jerusalem
LOG_LEVEL=info

# --- Listener IPC ---
# Default: data/listener.sock (local). For remote, change to tcp://host:port.
LISTENER_IPC=unix:./data/listener.sock
