{
  "name": "plicit",
  "version": "0.0.1",
  "private": true,
  "description": "Personal WhatsApp listener that captures, classifies, and turns conversations into calendar events, tasks, and notes.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "listener": "pnpm --filter @plicit/listener start",
    "analyzer": "pnpm --filter @plicit/analyzer start",
    "summarizer": "pnpm --filter @plicit/summarizer start",
    "review": "pnpm --filter @plicit/actions review",
    "shell": "pnpm --filter @plicit/shell start",
    "migrate": "pnpm --filter @plicit/db migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
